<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <PackageId>mathsolver</PackageId>
    <Version>0.1.0</Version>
    <Authors>mathsolver.help</Authors>
    <Description>BYOK AI math solver with independent verification — bring your own OpenAI-compatible API key, answers verified by local expression evaluation.</Description>
    <PackageProjectUrl>https://mathsolver.help</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mathsolver-help/mathsolver-dotnet</RepositoryUrl>
    <PackageTags>math solver ai byok verification step-by-step</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
